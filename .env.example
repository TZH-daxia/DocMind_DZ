# DocMind DZ 环境配置样例：复制为 .env 后填写密钥

# 接口统一前缀，前端 api.js 的 BASE 与之对应
DOCMIND_DZ_API_PREFIX=/dz
# 服务监听地址，127.0.0.1 仅本机可访问
DOCMIND_DZ_APP_HOST=127.0.0.1
# 服务端口，启动后访问 http://127.0.0.1:8010
DOCMIND_DZ_APP_PORT=8010
# 运行产物根目录（tasks/ 与 results/）
DOCMIND_DZ_DATA_ROOT=data
# 单个上传文件的大小上限（MB）
DOCMIND_DZ_MAX_FILE_SIZE_MB=50
# 单个文件最多处理的页数，超出任务失败
DOCMIND_DZ_MAX_PAGES=30
# 主模型密钥，必填；留空时任务直接失败
DOCMIND_DZ_MODEL_API_KEY=
# 主模型 OpenAI 兼容接口地址
DOCMIND_DZ_MODEL_BASE_URL=https://api.deepseek.com
# 主模型名称（文本抽取用）
DOCMIND_DZ_MODEL_NAME=deepseek-flash
# 主模型视觉名称（页面转写用）
DOCMIND_DZ_MODEL_VISION_NAME=deepseek-flash
# 采样温度，字段抽取建议保持 0
DOCMIND_DZ_MODEL_TEMPERATURE=0
# 是否启用模型思考模式，true/false
DOCMIND_DZ_MODEL_THINKING=false
# 兜底模型密钥，留空即关闭兜底
DOCMIND_DZ_FALLBACK_API_KEY=
# 兜底模型 OpenAI 兼容接口地址
DOCMIND_DZ_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 兜底文本模型名称
DOCMIND_DZ_FALLBACK_NAME=qwen-plus
# 兜底视觉模型名称
DOCMIND_DZ_FALLBACK_VISION_NAME=qwen-vl-max
# 文本模型调用超时时间（秒）
DOCMIND_DZ_MODEL_TIMEOUT_SECONDS=180
# 视觉模型调用超时时间（秒）
DOCMIND_DZ_MODEL_VISION_TIMEOUT_SECONDS=120
# 单个模型提供方的重试次数
DOCMIND_DZ_MODEL_CALL_RETRIES=1
# 同时进行的模型调用上限
DOCMIND_DZ_MODEL_MAX_CONCURRENCY=4
# 分单字段抽取的并发数
DOCMIND_DZ_HOUSE_BILL_CONCURRENCY=3
# 页面渲染 DPI，越高越清晰也越慢
DOCMIND_DZ_RENDER_DPI=200
# 文本层少于该字符数的页面改用视觉模型转写
DOCMIND_DZ_TEXT_LAYER_MIN_CHARS=180
# 是否强制所有页面走视觉模型转写
DOCMIND_DZ_FORCE_VLM=false
# 本地演示开关，true 时返回固定样例、不调用真实模型
DOCMIND_DZ_MOCK_LLM=false
# 产物保留时长（小时），<=0 表示永久保留
DOCMIND_DZ_DATA_RETENTION_HOURS=168

# 额外放行的前端来源，通常留空；本地 localhost / 127.0.0.1 / 本机 IP 已自动放行
DOCMIND_DZ_CORS_ALLOW_ORIGINS=
# 自定义跨域来源正则，留空则使用内置规则（本机地址任意端口，排除 3005）
DOCMIND_DZ_CORS_ALLOW_ORIGIN_REGEX=
