# DocMind DZ 环境配置（单证识别，线上 Docker 部署用）
#
# 用法：cp .env.example .env && chmod 600 .env  →  填下面【最小必需】→  docker compose up -d --build
# .env 不入库、不进镜像、不会被 git pull 覆盖。
#
# 改了 .env（只换配置）：docker compose up -d --force-recreate
# 后端迭代（拉了新代码）：git pull && docker compose up -d --build

# ═══════════════════ 最小必需（填完即可跑通） ═══════════════════

# 主模型密钥（DeepSeek）。留空时服务能起，但所有任务直接失败
DOCMIND_DZ_MODEL_API_KEY=

# ═══════════════════ 部署必核对（对外提供服务时） ═══════════════════

# 额外放行的前端来源（Origin，含协议与端口，多个用逗号分隔）。
# 本地 localhost / 127.0.0.1 / 本机 IP 已自动放行，线上需显式填 poOrder 的真实来源。
# 不要用 CORS_ALLOW_ALL —— 接口目前无鉴权，放开等于任意站点都能读走结果。
DOCMIND_DZ_CORS_ALLOW_ORIGINS=

# 宿主对外 HTTPS 端口（容器内固定 443）。与同机 DocMind（8443）错开
DOCMIND_DZ_HTTPS_PORT=8444

# ═══════════════════ 以下按需，默认值已可用（保持注释即可） ═══════════════════

# —— 服务基础 ——
# DOCMIND_DZ_API_PREFIX=/docmind_dz          # 改则同步前端 api.js 的 BASE
# DOCMIND_DZ_APP_HOST=127.0.0.1              # 容器内由 compose 覆盖为 0.0.0.0
# DOCMIND_DZ_APP_PORT=8010
# DOCMIND_DZ_DATA_ROOT=data
# DOCMIND_DZ_MAX_FILE_SIZE_MB=50             # 改大需同步 nginx client_max_body_size
# DOCMIND_DZ_MAX_PAGES=30                    # 单文件页数上限，超出任务失败
# DOCMIND_DZ_DATA_RETENTION_HOURS=24         # 产物保留时长，<=0 永久保留

# —— 主模型（文本抽取 + 页面转写）——
# DOCMIND_DZ_MODEL_BASE_URL=https://api.deepseek.com
# DOCMIND_DZ_MODEL_NAME=deepseek-flash
# DOCMIND_DZ_MODEL_VISION_NAME=deepseek-flash
# DOCMIND_DZ_MODEL_TEMPERATURE=0             # 字段抽取保持 0
# DOCMIND_DZ_MODEL_THINKING=true             # 抽取/分类开思考更稳
# DOCMIND_DZ_MODEL_VISION_THINKING=false     # 识图转写必须 false（开了漏字）
# DOCMIND_DZ_MODEL_TIMEOUT_SECONDS=300
# DOCMIND_DZ_MODEL_VISION_TIMEOUT_SECONDS=120
# DOCMIND_DZ_MODEL_CONNECT_TIMEOUT_SECONDS=10
# DOCMIND_DZ_MODEL_CALL_RETRIES=1

# —— 兜底模型（千问）：留空 API_KEY 即关闭兜底 ——
# DOCMIND_DZ_FALLBACK_API_KEY=
# DOCMIND_DZ_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DOCMIND_DZ_FALLBACK_NAME=qwen-plus
# DOCMIND_DZ_FALLBACK_VISION_NAME=qwen-vl-max
# DOCMIND_DZ_MODEL_CIRCUIT_FAILURES=3        # 连续失败多少次进熔断
# DOCMIND_DZ_MODEL_CIRCUIT_COOLDOWN_SECONDS=90

# —— 渲染 ——
# DOCMIND_DZ_RENDER_DPI=200                  # 越高越清晰也越慢
# DOCMIND_DZ_OFFICE_RENDER_ENABLED=true      # false = 只抽文本、无预览图
# DOCMIND_DZ_ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg

# —— 并发（超限一律排队不拒绝；单进程内生效，必须单 worker）——
# DOCMIND_DZ_MAX_CONCURRENT_TASKS=5
# DOCMIND_DZ_MODEL_MAX_CONCURRENCY=16        # 文本 + 视觉共用
# DOCMIND_DZ_HOUSE_BILL_CONCURRENCY=3        # 单任务内多份分单并行抽取
# DOCMIND_DZ_VISION_PAGE_CONCURRENCY=2
# DOCMIND_DZ_OFFICE_CONCURRENCY=1            # soffice 单实例，串行

# —— 结果与审核 ——
# DOCMIND_DZ_REVIEW_CONFIDENCE_THRESHOLD=0.8 # 低于该置信度进待人工审核

# —— 日志 ——
# DOCMIND_DZ_LOG_DIR=logs
# DOCMIND_DZ_LOG_LEVEL=INFO
# DOCMIND_DZ_LOG_CONSOLE=false
# DOCMIND_DZ_LOG_RETENTION_DAYS=14

# —— 跨域（一般只填上面那项 ALLOW_ORIGINS）——
# DOCMIND_DZ_CORS_ALLOW_ALL=false            # 生产必须 false
# DOCMIND_DZ_CORS_ALLOW_ORIGIN_REGEX=        # 留空用内置规则（本机任意端口，排除 3005）

# —— docker compose 构建参数 ——
# 注意：HOST / PORT / DATA_ROOT 若由 docker-compose.yml 注入，写这里不生效
# HOST_PORT=8010                             # 回环调试端口，仅 curl /health 与 SSH 隧道用

# ═══════════════════ 生效与自检 ═══════════════════
#
# 改 .env 后：docker compose up -d --force-recreate
# 改代码后：git pull && docker compose up -d --build
#
# curl -sk https://127.0.0.1:8444/health        # 期望 {"status":"ok","model_configured":true}
#                                               # model_configured=false 表示密钥没读到
# curl -skI https://127.0.0.1:8444/docs | head -1   # 期望 404（生产由 nginx 关闭接口文档）
